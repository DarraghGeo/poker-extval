{
  "name": "poker-extval",
  "version": "6.0.0-beta.5",
  "description": "Poker hand evaluator: made hands, draws, board-relative labels, villain range blockers, hand comparison and equity",
  "main": "evaluator.js",
  "module": "dist/poker-extval.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/poker-extval.mjs",
      "require": "./evaluator.js",
      "default": "./evaluator.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "evaluator.js",
    "index.d.ts",
    "src/",
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "jest && npm run test:types",
    "test:jest": "jest",
    "test:types": "tsc --noEmit --strict --target es2020 --module commonjs --moduleResolution node test/types.ts",
    "test:watch": "jest --watch",
    "benchmark": "node benchmark.js",
    "test:browser": "npm run build && node test/browser.js",
    "build": "node scripts/build-esm.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "poker",
    "hand",
    "evaluator",
    "poker-hand",
    "poker-evaluation",
    "card-game",
    "texas-holdem",
    "draws",
    "blockers",
    "range",
    "equity"
  ],
  "author": "Darragh Geoghegan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DarraghGeo/poker-extval.git"
  },
  "bugs": {
    "url": "https://github.com/DarraghGeo/poker-extval/issues"
  },
  "homepage": "https://github.com/DarraghGeo/poker-extval#readme",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.6.3",
    "poker-rangeman": "^4.0.0-beta.7"
  },
  "dependencies": {
    "poker-bitvaljs": "^1.12.0"
  },
  "peerDependencies": {
    "poker-rangeman": "^4.0.0-beta.7"
  },
  "types": "index.d.ts",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "moduleNameMapper": {
      "^poker-rangeman$": "<rootDir>/test/poker-rangeman.js"
    }
  }
}
